rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /nameRules/{ruleId} {
      // Replace with the verified Firebase Authentication email of the rules administrator.
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['source', 'target'])
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 200
        && request.resource.data.target is string
        && request.resource.data.target.size() > 0
        && request.resource.data.target.size() <= 200;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'pongsathorn.rd@gmail.com';
    }
  }
}
